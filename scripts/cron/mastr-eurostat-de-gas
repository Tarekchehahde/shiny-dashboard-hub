# Poll Germany natural-gas Eurostat cubes after catalogue refresh windows
# (11:00 and 23:00 CET). Script no-ops when all `updated` stamps are unchanged.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""
CRON_TZ=UTC

35 9,10,21,22 * * * root /usr/local/sbin/eurostat-sync-de-gas.py 2>&1 | logger -t mastr-eurostat-de-gas
