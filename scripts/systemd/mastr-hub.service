[Unit]
Description=MaStR dashboard hub (/dashboards/)
After=network.target

[Service]
Type=simple
User=rstudio
WorkingDirectory=/opt/mastr-shiny/WORK/shiny/hub
Environment=HOME=/home/rstudio
Environment=MASTR_HUB_MODE=paths
ExecStart=/usr/lib/R/bin/R -e "options(shiny.url.pathPrefix='/dashboards'); shiny::runApp('.', host='0.0.0.0', port=3838, launch.browser=FALSE)"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
